  162 create_package_stmt: CREATE opt_replace package_block

  163 package_block: PACKAGE sp_name opt_proc_clause opt_package_stmts END_KEY opt_tail_package_name

  164 invoke_right: AUTHID CURRENT_USER
  165             | AUTHID DEFINER

  166 proc_clause: invoke_right

  167 proc_clause_list: proc_clause_list proc_clause
  168                 | proc_clause

  169 opt_proc_clause: /* empty */
  170                | proc_clause_list

  171 opt_replace: /* empty */
  172            | OR REPLACE

  173 opt_package_stmts: /* empty */
  174                  | package_stmts

  175 package_stmts: package_stmts package_stmt ';'
  176              | package_stmt ';'

  177 package_stmt: sp_decl
  178             | func_decl
  179             | proc_decl

  180 func_decl: FUNCTION ident '(' opt_sp_param_list ')' RETURN sp_data_type

  181 proc_decl: PROCEDURE ident '(' opt_sp_param_list ')'

  182 opt_tail_package_name: /* empty */
  183                      | ident

  184 create_package_body_stmt: CREATE opt_replace package_body_block

  185 package_body_block: PACKAGE BODY sp_name decl_stmt_ext_list sp_proc_stmts END_KEY opt_tail_package_name
  186                   | PACKAGE BODY sp_name sp_proc_stmts END_KEY opt_tail_package_name
  187                   | PACKAGE BODY sp_name decl_stmt_ext_list END_KEY opt_tail_package_name
  188                   | PACKAGE BODY sp_name END_KEY opt_tail_package_name

  189 drop_package_stmt: DROP PACKAGE sp_name
  190                  | DROP PACKAGE BODY sp_name

  191 interface_pragma: PRAGMA INTERFACE '(' C ',' ident ')'

  192 decl_stmt_ext_list: decl_stmt_ext ';'
  193                   | decl_stmt_ext_list decl_stmt_ext ';'

  194 decl_stmt_ext: sp_decl
  195              | func_decl
  196              | proc_decl
  197              | interface_pragma
  198              | func_decl function_body
  199              | proc_decl procedure_body

  200 create_trigger_stmt: CREATE opt_sp_definer plsql_trigger_source

  201 plsql_trigger_source: TRIGGER opt_if_not_exists sp_name trigger_definition

  202 trigger_definition: trigger_time trigger_event ON sp_name FOR EACH ROW trigger_body
  203                   | trigger_time trigger_event ON sp_name FOR EACH ROW FOLLOWS sp_name trigger_body
  204                   | trigger_time trigger_event ON sp_name FOR EACH ROW PRECEDES sp_name trigger_body

  205 trigger_time: BEFORE
  206             | AFTER

  207 trigger_event: INSERT
  208              | DELETE
  209              | UPDATE

  210 trigger_body: sp_proc_stmt

  211 drop_trigger_stmt: DROP TRIGGER opt_if_exists sp_name

  212 create_procedure_stmt: CREATE opt_sp_definer PROCEDURE opt_if_not_exists sp_name '(' opt_sp_param_list ')' sp_create_chistics procedure_body
  213                      | CREATE opt_sp_definer PROCEDURE opt_if_not_exists sp_name '(' opt_sp_param_list ')' procedure_body

  214 create_function_stmt: CREATE opt_sp_definer FUNCTION opt_if_not_exists sp_name '(' opt_sp_fparam_list ')' RETURNS sp_data_type sp_create_chistics function_body
  215                     | CREATE opt_sp_definer FUNCTION opt_if_not_exists sp_name '(' opt_sp_fparam_list ')' RETURNS sp_data_type function_body

  216 opt_sp_definer: /* empty */
  217               | DEFINER '=' user opt_host_name
  218               | DEFINER '=' CURRENT_USER opt_parentheses

  219 user: STRING
  220     | IDENT

  221 opt_host_name: USER_VARIABLE
  222              | /* empty */

  223 opt_parentheses: /* empty */
  224                | '(' ')'

  225 opt_sp_param_list: /* empty */
  226                  | sp_param_list

  227 sp_param_list: sp_param_list ',' sp_param
  228              | sp_param

  229 sp_param: opt_sp_inout ident param_type opt_param_default

  230 opt_sp_fparam_list: /* empty */
  231                   | sp_fparam_list

  232 sp_fparam_list: sp_fparam_list ',' sp_fparam
  233               | sp_fparam

  234 sp_fparam: ident param_type

  235 opt_sp_inout: /* empty */
  236             | IN
  237             | OUT
  238             | INOUT

  239 param_type: sp_data_type

  240 simple_ident: ident
  241             | ident '.' ident
  242             | '.' ident '.' ident
  243             | ident '.' ident '.' ident

  244 sp_create_chistics: sp_create_chistic
  245                   | sp_create_chistics sp_create_chistic

  246 sp_create_chistic: sp_chistic
  247                  | DETERMINISTIC
  248                  | NOT DETERMINISTIC

  249 sp_chistic: COMMENT STRING
  250           | LANGUAGE SQL
  251           | NO SQL
  252           | CONTAINS SQL
  253           | READS SQL DATA
  254           | MODIFIES SQL DATA
  255           | SQL SECURITY DEFINER
  256           | SQL SECURITY INVOKER

  257 procedure_body: sp_proc_stmt

  258 function_body: sp_proc_independent_statement

  259 alter_procedure_stmt: ALTER PROCEDURE sp_name opt_sp_alter_chistics

  260 alter_function_stmt: ALTER FUNCTION sp_name opt_sp_alter_chistics

  261 opt_sp_alter_chistics: /* empty */
  262                      | sp_alter_chistics

  263 sp_alter_chistics: sp_chistic
  264                  | sp_alter_chistics sp_chistic

  265 sp_proc_stmt: sp_proc_outer_statement
  266             | sp_proc_inner_statement

  267 sp_proc_outer_statement: outer_stmt

  268 sp_proc_inner_statement: sp_proc_independent_statement
  269                        | sp_proc_stmt_iterate
  270                        | sp_proc_stmt_leave
  271                        | sp_proc_stmt_open
  272                        | sp_proc_stmt_fetch
  273                        | sp_proc_stmt_close

  274 sp_proc_independent_statement: sp_proc_stmt_if
  275                              | sp_proc_stmt_case
  276                              | sp_unlabeled_block
  277                              | sp_labeled_block
  278                              | sp_unlabeled_control
  279                              | sp_labeled_control
  280                              | sp_proc_stmt_return

  281 sp_proc_stmt_if: IF sp_if END_KEY IF

  282 sp_if: expr THEN sp_proc_stmts sp_elseifs
  283      | expr THEN sp_proc_stmts

  284 sp_proc_stmt_case: CASE expr sp_when_list sp_elseifs END_KEY CASE
  285                  | CASE expr sp_when_list END_KEY CASE

  286 sp_when_list: sp_when
  287             | sp_when_list sp_when

  288 sp_when: WHEN expr THEN sp_proc_stmts

  289 sp_elseifs: ELSEIF sp_if
  290           | ELSE sp_proc_stmts

  291 sp_unlabeled_block: sp_block_content

  292 sp_block_content: BEGIN_KEY END_KEY
  293                 | BEGIN_KEY sp_decls END_KEY
  294                 | BEGIN_KEY sp_proc_stmts END_KEY
  295                 | BEGIN_KEY sp_decls sp_proc_stmts END_KEY

  296 sp_labeled_block: label_ident ':' sp_block_content opt_sp_label

  297 label_ident: ident

  298 opt_sp_label: /* empty */
  299             | label_ident

  300 sp_proc_stmts: sp_proc_stmt ';'
  301              | sp_proc_stmts sp_proc_stmt ';'

  302 sp_decls: sp_decls ';'
  303         | opt_sp_decls sp_decl ';'

  304 opt_sp_decls: /* empty */
  305             | opt_sp_decls sp_decl ';'

  306 sp_decl: DECLARE sp_decl_idents sp_data_type opt_sp_decl_default
  307        | DECLARE ident CONDITION FOR sp_cond
  308        | DECLARE sp_handler_type HANDLER FOR sp_hcond_list sp_proc_stmt
  309        | DECLARE ident CURSOR FOR sql_stmt

  310 sp_handler_type: EXIT
  311                | CONTINUE

  312 sp_hcond_list: sp_hcond
  313              | sp_hcond_list ',' sp_hcond

  314 sp_hcond: sp_cond
  315         | ident
  316         | SQLWARNING
  317         | NOT FOUND
  318         | SQLEXCEPTION

  319 sp_cond: number_literal
