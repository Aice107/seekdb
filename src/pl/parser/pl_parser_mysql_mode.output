  321 sqlstate: SQLSTATE opt_value STRING

  322 sp_proc_stmt_open: OPEN ident

  323 sp_proc_stmt_close: CLOSE ident

  324 sp_proc_stmt_fetch: FETCH ident into_clause
  325                   | FETCH FROM ident into_clause
  326                   | FETCH NEXT FROM ident into_clause

  327 into_clause: INTO expr_list

  328 opt_value: /* empty */
  329          | VALUE

  330 sp_decl_idents: ident
  331               | sp_decl_idents ',' ident

  332 sp_data_type: scalar_data_type

  333 opt_sp_decl_default: /* empty */
  334                    | DEFAULT default_expr

  335 opt_param_default: /* empty */
  336                  | DEFAULT default_expr

  337 default_expr: /* empty */

  338 expr_list: expr
  339          | expr_list ',' expr

  340 expr: /* empty */

  341 sp_unlabeled_control: LOOP sp_proc_stmts END_KEY LOOP
  342                     | WHILE expr DO sp_proc_stmts END_KEY WHILE
  343                     | REPEAT sp_proc_stmts UNTIL expr END_KEY REPEAT

  344 sp_labeled_control: label_ident ':' sp_unlabeled_control opt_sp_label

  345 sp_proc_stmt_return: RETURN expr

  346 sp_proc_stmt_iterate: ITERATE label_ident

  347 sp_proc_stmt_leave: LEAVE label_ident

  348 drop_procedure_stmt: DROP PROCEDURE opt_if_exists sp_name

  349 drop_function_stmt: DROP FUNCTION opt_if_exists sp_name

