终端机在文法中未使用

   SQL_TOKEN
   PARSER_SYNTAX_ERROR
   USER_NAME
   BY
   INDEX
   IS
   LIMIT
   USING
   SUBMIT
   CANCEL
   JOB
   DECLARATION


语法

    0 $accept: stmt_block $end

    1 stmt_block: stmt_list END_P

    2 stmt_list: stmt_list ';' stmt
    3          | stmt

    4 stmt: outer_stmt
    5     | /* empty */

    6 outer_stmt: create_procedure_stmt
    7           | create_function_stmt
    8           | drop_procedure_stmt
    9           | drop_function_stmt
   10           | alter_procedure_stmt
   11           | alter_function_stmt
   12           | create_package_stmt
   13           | create_package_body_stmt
   14           | drop_package_stmt
   15           | sql_stmt
   16           | call_sp_stmt
   17           | do_sp_stmt
   18           | signal_stmt
   19           | resignal_stmt
   20           | package_block
   21           | package_body_block
   22           | create_trigger_stmt
   23           | drop_trigger_stmt
   24           | plsql_trigger_source

   25 sql_keyword: SQL_KEYWORD
   26            | TABLE
   27            | USER

   28 sql_stmt_prefix: '(' sql_stmt_prefix
   29                | SQL_KEYWORD
   30                | INSERT
   31                | DELETE
   32                | UPDATE
   33                | LOAD

   34 sql_stmt: sql_stmt_prefix
   35         | REPLACE
   36         | CREATE sql_keyword
   37         | CREATE ROLE
   38         | DROP ROLE
   39         | CREATE OR REPLACE sql_keyword
   40         | DROP sql_keyword
   41         | ALTER sql_keyword
   42         | RENAME sql_keyword
   43         | SET
   44         | COMMIT
   45         | ROLLBACK
   46         | SELECT
   47         | '(' SELECT

   48 do_sp_stmt: DO expr_list
   49           | DO sp_proc_stmt_open
   50           | DO sp_proc_stmt_fetch
   51           | DO sp_proc_stmt_close

   52 call_sp_stmt: CALL sp_call_name opt_sp_cparam_list
   53             | '^' sp_proc_stmt
   54             | '^' PROCEDURE opt_if_not_exists sp_name '(' opt_sp_param_list ')' sp_create_chistics procedure_body
   55             | '^' PROCEDURE opt_if_not_exists sp_name '(' opt_sp_param_list ')' procedure_body
   56             | '^' FUNCTION opt_if_not_exists sp_name '(' opt_sp_fparam_list ')' RETURNS sp_data_type sp_create_chistics function_body
   57             | '^' FUNCTION opt_if_not_exists sp_name '(' opt_sp_fparam_list ')' RETURNS sp_data_type function_body

   58 opt_sp_cparam_list: /* empty */
   59                   | '(' ')'
   60                   | '(' sp_cparams ')'

   61 sp_cparams: sp_cparams ',' sp_cparam
   62           | sp_cparam

   63 sp_cparam: cexpr opt_sp_cparam_with_assign

   64 opt_sp_cparam_with_assign: /* empty */
   65                          | PARAM_ASSIGN_OPERATOR cexpr

   66 cexpr: /* empty */

   67 sp_name: ident '.' ident
   68        | ident

   69 sp_call_name: ident '.' ident '.' ident
   70             | ident '.' ident
   71             | ident

   72 ident: IDENT
   73      | unreserved_keyword

